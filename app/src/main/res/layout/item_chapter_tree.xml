<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">

    <!-- 左侧彩色条 (5dp -> 加大可见性) -->
    <View
        android:id="@+id/colorBar"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#6750A4" />

    <!-- 主行内容 -->
    <LinearLayout
        android:id="@+id/contentRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true">

        <!-- 层级小圆点 (子级才显示，加大加实) -->
        <View
            android:id="@+id/levelDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_level_dot"
            android:visibility="gone" />

        <!-- 展开/折叠按钮 -->
        <FrameLayout
            android:id="@+id/btnExpand"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgExpand"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_expand_right" />
        </FrameLayout>

        <!-- 标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@android:color/black" />

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 标记 -->
            <FrameLayout
                android:id="@+id/btnMark"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgMark"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_star_outline" />
            </FrameLayout>

            <!-- 重命名 -->
            <FrameLayout
                android:id="@+id/btnRename"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgRename"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_edit" />
            </FrameLayout>

            <!-- 删除 -->
            <FrameLayout
                android:id="@+id/btnDelete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgDelete"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close" />
            </FrameLayout>

            <!-- 上移 -->
            <FrameLayout
                android:id="@+id/btnMoveUp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgMoveUp"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_up" />
            </FrameLayout>

            <!-- 下移 -->
            <FrameLayout
                android:id="@+id/btnMoveDown"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgMoveDown"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_down" />
            </FrameLayout>

            <!-- 添加子章节 -->
            <FrameLayout
                android:id="@+id/btnAddChild"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgAddChild"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
